<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_refresh_market_prices" model="ir.cron">
            <field name="name">Market Tracker: Auto-Refresh Prices</field>
            <field name="model_id" ref="model_market_symbol"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_prices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
